{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "VisualEditor0",
            "Effect": "Allow",
            "Action": "ssm:GetParameters",
            "Resource": [
                "arn:aws:ssm:us-east-1:${account_id}:parameter/${project}/${environment}/rabbitmq_user",
                "arn:aws:ssm:us-east-1:${account_id}:parameter/${project}/${environment}/rabbitmq_passwrod"
            ]
        },
        {
            "Sid": "VisualEditor1",
            "Effect": "Allow",
            "Action": "ssm:DescribeParameters",
            "Resource": "*"
        }
    ]
}